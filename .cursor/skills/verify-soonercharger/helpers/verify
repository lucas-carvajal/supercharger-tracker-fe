#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
VERIFY_RUN_ID="${VERIFY_RUN_ID:-default}"
STATE_DIR="${VERIFY_STATE_DIR:-/tmp/soonercharger-verify-${VERIFY_RUN_ID}}"
EVIDENCE_DIR="${VERIFY_EVIDENCE_DIR:-/tmp/soonercharger-verify-evidence/${VERIFY_RUN_ID}}"
DEFAULT_PORT="${VERIFY_PORT:-4310}"
DEFAULT_HOST="${VERIFY_HOST:-127.0.0.1}"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: helpers/verify <command>

Commands:
  launch     Start an isolated next dev for this VERIFY_RUN_ID
  doctor     Read-only health check of the instance this run started
  origin     Print the instance origin URL
  curl PATH  GET PATH on this instance and print status plus body
  cleanup    Stop the process this run started. Keep evidence.

Env:
  VERIFY_RUN_ID       Run id. Default: default
  VERIFY_PORT         Listen port. Default: 4310
  VERIFY_HOST         Bind host. Default: 127.0.0.1
  VERIFY_BACKEND_URL  Optional Rust API. Unset means no-backend mode
  VERIFY_STATE_DIR    Override state directory
  VERIFY_EVIDENCE_DIR Override evidence directory
EOF
}

state_file() {
  printf '%s/%s' "$STATE_DIR" "$1"
}

read_state() {
  local key="$1"
  local path
  path="$(state_file "$key")"
  [[ -f "$path" ]] || die "missing state $path. Run helpers/verify launch first."
  cat "$path"
}

pid_alive() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

kill_tree() {
  local pid="$1"
  local child
  if ! pid_alive "$pid"; then
    return 0
  fi
  while read -r child; do
    [[ -n "$child" ]] || continue
    kill_tree "$child"
  done < <(pgrep -P "$pid" || true)
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

port_holder_pid() {
  local port="$1"
  local pid
  pid="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -n 1)"
  if [[ -z "$pid" ]]; then
    pid="$(
      netstat -tlnp 2>/dev/null |
        awk -v suffix=":${port}" '$4 ~ suffix"$" { split($7, a, "/"); print a[1]; exit }'
    )"
  fi
  [[ -n "$pid" && "$pid" != "-" ]] || return 1
  printf '%s\n' "$pid"
}

pid_in_tree() {
  local needle="$1"
  local root="$2"
  local child
  [[ "$needle" == "$root" ]] && return 0
  while read -r child; do
    [[ -n "$child" ]] || continue
    if pid_in_tree "$needle" "$child"; then
      return 0
    fi
  done < <(pgrep -P "$root" || true)
  return 1
}

lockfile_other_dev() {
  local lock="$REPO_ROOT/.next/dev/lock"
  local content pid
  [[ -f "$lock" ]] || return 1
  content="$(cat "$lock" 2>/dev/null || true)"
  pid="$(printf '%s' "$content" | sed -n 's/.*"pid":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1)"
  [[ -n "$pid" ]] || return 1
  pid_alive "$pid" || return 1
  printf '%s\n' "$pid"
}

wait_ready() {
  local origin="$1"
  local i
  for i in $(seq 1 90); do
    if curl -fsS --max-time 2 "${origin}/api/health" 2>/dev/null | grep -q '"status":"ok"'; then
      return 0
    fi
    sleep 1
  done
  return 1
}

cmd_launch() {
  mkdir -p "$STATE_DIR" "$EVIDENCE_DIR"

  if [[ -f "$(state_file pid)" ]]; then
    local existing
    existing="$(cat "$(state_file pid)")"
    if pid_alive "$existing" && [[ -f "$(state_file origin)" ]]; then
      local origin
      origin="$(cat "$(state_file origin)")"
      if curl -fsS --max-time 2 "${origin}/api/health" 2>/dev/null | grep -q '"status":"ok"'; then
        printf 'reused %s pid=%s\n' "$origin" "$existing"
        return 0
      fi
    fi
  fi

  local other
  if other="$(lockfile_other_dev)"; then
    die "another next dev holds this checkout (pid ${other}). Refuse to share it. Stop that process or use another worktree."
  fi

  local port="$DEFAULT_PORT"
  local host="$DEFAULT_HOST"
  local holder
  if holder="$(port_holder_pid "$port")"; then
    die "port ${port} is already in use by pid ${holder}. Set VERIFY_PORT to a free port."
  fi

  local origin="http://${host}:${port}"
  local secret
  secret="$(openssl rand -hex 32)"
  local mode="no-backend"
  [[ -n "${VERIFY_BACKEND_URL:-}" ]] && mode="live-backend"

  : >"$STATE_DIR/next.log"

  local env_opts=(-u NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN)
  local env_assign=(
    PORT="$port"
    HOSTNAME="$host"
    SITE_URL="$origin"
    ADMIN_USERNAME="${VERIFY_ADMIN_USERNAME:-verify-admin}"
    ADMIN_PASSWORD="${VERIFY_ADMIN_PASSWORD:-verify-admin-password}"
    ADMIN_SESSION_SECRET="$secret"
  )
  if [[ -n "${VERIFY_BACKEND_URL:-}" ]]; then
    env_assign+=(
      BACKEND_URL="$VERIFY_BACKEND_URL"
      RUST_INTERNAL_IMPORT_SECRET="${VERIFY_IMPORT_SECRET:-verify-import-secret}"
    )
  else
    env_opts+=(-u BACKEND_URL -u RUST_INTERNAL_IMPORT_SECRET)
  fi

  (
    cd "$REPO_ROOT"
    env "${env_opts[@]}" "${env_assign[@]}" \
      npx next dev --hostname "$host" --port "$port"
  ) >>"$STATE_DIR/next.log" 2>&1 &
  local pid=$!

  printf '%s\n' "$pid" >"$(state_file pid)"
  printf '%s\n' "$port" >"$(state_file port)"
  printf '%s\n' "$host" >"$(state_file host)"
  printf '%s\n' "$origin" >"$(state_file origin)"
  printf '%s\n' "$mode" >"$(state_file mode)"
  printf '%s\n' "$VERIFY_RUN_ID" >"$(state_file run_id)"

  if ! wait_ready "$origin"; then
    kill_tree "$pid"
    die "next dev did not become ready on ${origin}. See ${STATE_DIR}/next.log"
  fi

  printf 'ready %s pid=%s mode=%s evidence=%s\n' "$origin" "$pid" "$mode" "$EVIDENCE_DIR"
}

cmd_doctor() {
  local pid origin port host mode holder
  pid="$(read_state pid)"
  origin="$(read_state origin)"
  port="$(read_state port)"
  host="$(read_state host)"
  mode="$(read_state mode)"

  pid_alive "$pid" || die "pid ${pid} is not running"

  holder="$(port_holder_pid "$port" || true)"
  [[ -n "$holder" ]] || die "nothing listens on ${host}:${port}"
  pid_in_tree "$holder" "$pid" || die "port ${port} is held by pid ${holder}, not this run (pid ${pid})"

  local health
  health="$(curl -fsS --max-time 5 "${origin}/api/health")" || die "GET ${origin}/api/health failed"
  printf '%s' "$health" | grep -q '"status":"ok"' || die "health body was ${health}"

  local home
  home="$(curl -fsS --max-time 10 "${origin}/")" || die "GET ${origin}/ failed"
  printf '%s' "$home" | grep -q 'Soonercharger' || die "home HTML does not contain Soonercharger"

  printf 'ok origin=%s pid=%s port=%s mode=%s health=%s\n' "$origin" "$pid" "$port" "$mode" "$health"
}

cmd_origin() {
  read_state origin
}

cmd_curl() {
  local path="${1:-}"
  [[ -n "$path" ]] || die "usage: helpers/verify curl /path"
  [[ "$path" == /* ]] || die "path must start with /"

  local origin dest status body
  origin="$(read_state origin)"
  mkdir -p "$EVIDENCE_DIR"
  dest="$EVIDENCE_DIR/$(printf '%s' "$path" | tr '/?' '__')"
  status="$(curl -sS -o "${dest}.body" -w '%{http_code}' --max-time 20 "${origin}${path}")"
  printf '%s\n' "$status" >"${dest}.status"
  printf '%s %s%s\n' "$status" "$origin" "$path"
  printf 'body %s.body\n' "$dest"
}

cmd_cleanup() {
  if [[ ! -d "$STATE_DIR" ]]; then
    printf 'no state dir %s\n' "$STATE_DIR"
    return 0
  fi
  if [[ -f "$(state_file pid)" ]]; then
    local pid
    pid="$(cat "$(state_file pid)")"
    kill_tree "$pid"
  fi
  rm -rf "$STATE_DIR"
  printf 'cleaned state. evidence kept at %s\n' "$EVIDENCE_DIR"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    launch) cmd_launch ;;
    doctor) cmd_doctor ;;
    origin) cmd_origin ;;
    curl)
      cmd_curl "${1:-}"
      ;;
    cleanup) cmd_cleanup ;;
    -h | --help | help | "") usage ;;
    *)
      usage
      die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
